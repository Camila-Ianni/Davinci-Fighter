{
copyright = "Copyright Patrick H. Lauke 2024-2025";
customParameters = (
{
name = description;
value = "<p>Recreation of one of the large pixel font from Capcom's \"Super Street Fighter II: The New Challengers\" (1993).</p>\n\n<p>This font is used for the score counter, \"You win\"/\"You lose\", in-fight messages (for first hits, combos, etc.), and the after-match taunts.</p>\n\n<p>Some of the characters (such as the \"M\") are one pixel wider than the overall monospaced character width of 12 pixels, so their drop shadow overlaps/falls behind the following character, which is game-accurate.</p>\n\n<p>This recreation is available in TrueType+COLR, TrueType+SVG, and WOFF2. For a monochrome version, see&nbsp;<a href=\"https://fontstruct.com/fontstructions/show/2470450/super-street-fighter-ii-large\" rel=\"nofollow\" target=\"_blank\">this recreation</a>.</p>\n\n<p>Only the characters present in the game's tile set have been included.</p>";
},
{
name = license;
value = "The FontStruction \U201cSuper Street Fighter II (Large)  (Colour)\U201d (https://fontstruct.com/fontstructions/show/2470663) by Patrick H. Lauke is licensed under a Creative Commons Attribution license (http://creativecommons.org/licenses/by/3.0/).\r\n\U201cSuper Street Fighter II (Large)  (Colour)\U201d was originally cloned (copied) from the FontStruction \U201cSuper Street Fighter II (Large)\U201d (https://fontstruct.com/fontstructions/show/2470450) by Patrick H. Lauke, which is licensed under a Creative Commons Attribution license (http://creativecommons.org/licenses/by/3.0/).";
},
